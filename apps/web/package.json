{
  "name": "@beenhere/web",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "prepare:ocr": "node scripts/prepare-ocr-worker.mjs",
    "predev": "npm run prepare:ocr",
    "dev": "vite",
    "prebuild": "npm run prepare:ocr",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "deploy": "npm run build && wrangler deploy",
    "cf:typegen": "wrangler types worker/env.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply beenhere-records --local",
    "db:migrate:remote": "wrangler d1 migrations apply beenhere-records --remote",
    "titles:backfill:remote": "node --experimental-strip-types scripts/backfill-record-titles.mjs"
  },
  "dependencies": {
    "@paddleocr/paddleocr-js": "0.4.2",
    "lucide-react": "^1.38.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.2",
    "@cloudflare/workers-types": "latest",
    "@tailwindcss/vite": "^4.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "latest",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  }
}
