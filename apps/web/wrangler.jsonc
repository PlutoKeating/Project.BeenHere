{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "project-been-here",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "beenhere.arr2018.dpdns.org",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "beenhere-records",
      "database_id": "9a227e92-b93f-4718-9abe-92569baf1776",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "SITE_URL": "https://beenhere.arr2018.dpdns.org",
    "SMTP_HOST": "smtp.yeah.net",
    "SMTP_PORT": "465",
    "SMTP_FROM_NAME": "来过"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "upload_source_maps": true
}
